{% if entry.doi %}
  <script>
    (() => {
      const publication = document.currentScript.closest('#{{ entry.key }}');
      const title = publication?.querySelector('.title');
      const doi = 'https://doi.org/{{ entry.doi }}';

      if (title && !title.querySelector('a')) {
        const link = document.createElement('a');
        link.href = doi;
        link.target = '_blank';
        link.rel = 'external noopener';
        link.textContent = title.textContent;
        title.replaceChildren(link);
      }

      const removeDoiButton = () => {
        const links = publication?.querySelector('.links');
        links?.querySelector(`a[href="${doi}"]`)?.remove();
        if (links && !links.querySelector('a')) links.remove();
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', removeDoiButton, { once: true });
      } else {
        removeDoiButton();
      }
    })();
  </script>
{% endif %}
